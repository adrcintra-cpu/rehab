---
import '../styles/global.css';
import { config } from '../data/content';
interface Props { title?: string; description?: string; }
const { title = config.title, description = config.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F0EAE1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,100,0,0&amp;icon_names=add,arrow_back,arrow_downward,arrow_outward,arrow_upward,close,menu&amp;display=block" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo-vertical.svg" />
    <link rel="preload" href="/fonts/raleway-light.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/aviano.ttf" as="font" type="font/ttf" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title><meta name="description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={config.name} /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/brand/social.png', Astro.site || Astro.url.origin).toString()} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="REHAB Clinic Club — Your move. Your evolution." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="topo"><a class="skip-link" href="#conteudo">Pular para o conteúdo</a><slot /></body>
</html>
