---
import '../styles/global.css';
import { config } from '../data/content';
interface Props { title?: string; description?: string; }
const { title = config.title, description = config.description } = Astro.props;
const gtmId = /^GTM-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GTM_ID || '') ? import.meta.env.PUBLIC_GTM_ID : '';
const structuredData = { '@context': 'https://schema.org', '@graph': [
 { '@type': 'Organization', '@id': new URL('/#organization', Astro.site!).href, name: config.name, url: Astro.site!.href, logo: new URL('/brand/social.png', Astro.site!).href, email: 'alphaplaybrasil@gmail.com', telephone: '+5511920132297' },
 { '@type': 'WebSite', '@id': new URL('/#website', Astro.site!).href, name: config.name, url: Astro.site!.href, inLanguage: 'pt-BR', publisher: { '@id': new URL('/#organization', Astro.site!).href } }
] };
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    {gtmId && <script is:inline define:vars={{ gtmId }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);</script>}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F0EAE1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,100,0,0&amp;icon_names=add,arrow_back,arrow_downward,arrow_outward,arrow_upward,calendar_month,chat,close,hub,location_on,menu,videocam&amp;display=block" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=rehab-20261110" />
    <link rel="preload" href="/fonts/raleway-light.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/aviano.ttf" as="font" type="font/ttf" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title><meta name="description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={config.name} /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/brand/social.png', Astro.site || Astro.url.origin).toString()} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="REHAB Clinic Club" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/brand/social.png', Astro.site!).href} />
  </head>
  <body id="topo">{gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}<a class="skip-link" href="#conteudo">Pular para o conteúdo</a><slot /><a class="whatsapp-float" href="https://wa.me/5511920132297" target="_blank" rel="noopener noreferrer" aria-label="Conversar com REHAB Clinic Club no WhatsApp (abre em nova aba)"><svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M27 15.5A11.5 11.5 0 0 1 9.7 25.4L4 27l1.6-5.6A11.5 11.5 0 1 1 27 15.5Z"/><path d="M11.3 9.7c-.5-.3-1.1-.1-1.4.4-1.3 2 .1 5.1 2.9 7.9s5.8 4.1 7.8 2.8c.6-.4.8-1 .4-1.5l-2-1.6c-.4-.3-.8-.3-1.1.1l-.8.9c-1.8-.7-3.9-2.8-4.6-4.6l.9-.8c.4-.3.4-.8.1-1.1Z"/></svg><span>WhatsApp</span></a></body>
</html>
