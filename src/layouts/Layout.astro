---
import '../styles/global.css';
import { config } from '../data/content';
interface Props { title?: string; description?: string; }
const { title = config.title, description = config.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F0EAE1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,100,0,0&amp;icon_names=add,arrow_back,arrow_downward,arrow_outward,arrow_upward,calendar_month,chat,close,hub,location_on,menu,videocam&amp;display=block" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=rehab-20261110" />
    <link rel="preload" href="/fonts/raleway-light.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/aviano.ttf" as="font" type="font/ttf" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title><meta name="description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={config.name} /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/brand/social.png', Astro.site || Astro.url.origin).toString()} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="REHAB Clinic Club" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="topo"><a class="skip-link" href="#conteudo">Pular para o conteúdo</a><slot /><a class="whatsapp-float" href="https://wa.me/5511920132297" target="_blank" rel="noopener noreferrer" aria-label="Conversar com REHAB Clinic Club no WhatsApp (abre em nova aba)"><svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M27 15.5A11.5 11.5 0 0 1 9.7 25.4L4 27l1.6-5.6A11.5 11.5 0 1 1 27 15.5Z"/><path d="M11.3 9.7c-.5-.3-1.1-.1-1.4.4-1.3 2 .1 5.1 2.9 7.9s5.8 4.1 7.8 2.8c.6-.4.8-1 .4-1.5l-2-1.6c-.4-.3-.8-.3-1.1.1l-.8.9c-1.8-.7-3.9-2.8-4.6-4.6l.9-.8c.4-.3.4-.8.1-1.1Z"/></svg><span>WhatsApp</span></a></body>
</html>
