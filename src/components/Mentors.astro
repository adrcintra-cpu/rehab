---
import { mentors } from '../data/content';
---
<section class="mentors section wrap" id="mentoras" aria-labelledby="mentors-title">
 <div class="section-heading" data-reveal><p class="eyebrow">As mentoras</p><h2 id="mentors-title">Quem serão<br /><span class="muted">suas mentoras.</span></h2><p>Duas trajetórias que conectam excelência clínica, gestão e desenvolvimento empresarial.</p></div>
 <p class="mentor-context">Vanessa Madaschi e Bárbara Soares conhecem os desafios de crescer preservando a essência do cuidado. Suas experiências se complementam para ajudar você a estruturar uma empresa mais forte e ampliar o impacto que já gera na vida das pessoas.</p>
 <div class="mentors-grid">{mentors.map((mentor,i)=><article class="mentor" data-reveal><div class:list={['mentor-portrait',`portrait-${i}`,'mentor-portrait-photo']}><img class="mentor-photo" src={mentor.name === 'Bárbara Soares' ? '/images/barbara-soares.webp' : '/images/vanessa-madaschi-v2.webp'} alt={mentor.name} width="1000" height={mentor.name === 'Bárbara Soares' ? 1137 : 1278} loading="lazy" /></div><p class="eyebrow mentor-role">{mentor.role}</p><h3>{mentor.name}</h3><p>{mentor.description}</p><ul class="mentor-themes">{mentor.themes.map(theme=><li>{theme}</li>)}</ul></article>)}</div>
</section>
