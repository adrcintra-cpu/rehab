---
import { audience } from '../data/content';
---
<section class="tools section" aria-labelledby="tools-title"><div class="wrap editorial-grid"><div class="tools-intro" data-reveal><p class="eyebrow">Para quem é</p><h2 id="tools-title">O Rehab Clinic Club<br /><span class="muted">é para você que:</span></h2><p class="tools-note">Para donos de clínicas de reabilitação que querem assumir seu papel como empresários e construir um negócio mais sólido e independente.</p></div><div class="tools-list">{audience.map(([title,text],i)=><article class="audience-card"><span class="card-index">{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
